# Copy to .env and fill in. .env is gitignored - never commit real values.

# Required. Signs access tokens. Generated automatically on first run if
# absent (see utils/tokens.ensure_jwt_secret), but set it explicitly for
# any deployment you care about.
JWT_SECRET_KEY=

# Required for GitHub sign-in. Create at:
#   GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the "Authorization callback URL" in that OAuth App EXACTLY -
# one extra slash and GitHub rejects the sign-in. For a local run on the
# documented port:
#   http://localhost:8000/api/v1/auth/github/callback
GITHUB_REDIRECT_URI=

# Required for GitHub sign-in. Signs the short-lived cookie that carries
# the OAuth `state` value between the redirect out and the callback back.
SESSION_SECRET_KEY=

# Which sign-in providers to offer. Defaults to github alone. Google and
# Microsoft are implemented (services/oauth_service.py) but switched off;
# add their credentials and list them here to enable, e.g.
#   OAUTH_ENABLED_PROVIDERS=github,google
OAUTH_ENABLED_PROVIDERS=github

# Only needed if you enable them above.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=


# =====================================================================
# Outbound email
# =====================================================================
# Password reset codes and email verification codes leave through here.
#
# With NOTHING set the app falls back to the "log" transport: the code
# is written to the server log, where whoever runs the deployment can
# read it out. That is a deliberate downgrade, not a fallback that
# happens to work - the code is never returned over HTTP, because doing
# that used to make knowing somebody's email address enough to take
# over their account.
#
# Set SMTP_HOST and the rest go to a real inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@digital-wellness-ai.local
SMTP_STARTTLS=1
SMTP_TIMEOUT=10

# smtp | log | memory. Leave unset: smtp when SMTP_HOST is set, log
# otherwise. "memory" is for tests and drops mail on the floor.
# MAIL_TRANSPORT=


# =====================================================================
# Storage engine
# =====================================================================
# json (default) writes storage/*.json, one file per store, with an
# OS-level lock around every read-modify-write. Correct, and it cannot
# take a second worker: every write rewrites a whole file.
#
# sqlite is the same StorageBackend interface over a real database -
# WAL, per-store transactions, an index on (store, user_id), and
# versioned migrations in services/storage/migrations.py.
#
# It is NOT the default, because switching it silently would strand
# every existing install behind an empty database. To move:
#
#   python3 -m services.storage.import_json           # dry run, prints the plan
#   python3 -m services.storage.import_json --write   # copies; deletes nothing
#   DWAI_STORAGE_BACKEND=sqlite python run.py
#
# The JSON files are left in place, so unsetting this reverts.
# DWAI_STORAGE_BACKEND=sqlite
# DWAI_SQLITE_PATH=storage/dwai.db
