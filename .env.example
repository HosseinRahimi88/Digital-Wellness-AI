# Copy this file to .env and fill in real values. .env itself is not
# committed (it would contain a real secret) - this template is.

# Required to issue/verify API access tokens (services/account_service.py
# -> utils/tokens.py). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters.
JWT_SECRET_KEY=

# --- api/core/config.py settings (all optional, shown with defaults) ---
# APP_NAME="Digital Wellness AI API"
# APP_VERSION=1.0.0
# API_PREFIX=/api/v1
# DEBUG=false

# Comma-separated. Empty = no cross-origin access allowed.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated. "*" (default) disables the check - set explicitly in production.
# TRUSTED_HOSTS=api.example.com,localhost

# ACCESS_TOKEN_EXPIRE_MINUTES=60
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100
